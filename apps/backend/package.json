{
  "name": "@aura/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-engine.mjs && nest start --watch",
    "build": "nest build && node scripts/mark-dist-esm.mjs && node scripts/build-engine.mjs",
    "start": "node dist/main.js",
    "db:migrate": "nest build && node scripts/mark-dist-esm.mjs && node scripts/build-engine.mjs && node dist/auth/migrate.js",
    "build:engine": "node scripts/build-engine.mjs"
  },
  "dependencies": {
    "@aura/types": "*",
    "@neondatabase/serverless": "^1.2.1",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "better-auth": "^1.7.25",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.24.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
