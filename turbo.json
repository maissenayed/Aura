{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["DATABASE_URL", "POSTGRES_URL", "CAMPAIGN_AUTH", "CAMPAIGN_DATA_DIR"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["BACKEND_ORIGIN", "NEXT_PUBLIC_API_URL", "VERCEL"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@aura/backend#build": {
      "dependsOn": ["^build"],
      "env": ["BACKEND_ORIGIN", "NEXT_PUBLIC_API_URL", "VERCEL"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/web/src/**"],
      "outputs": ["dist/**", "src/engine/aura-engine.mjs"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}
